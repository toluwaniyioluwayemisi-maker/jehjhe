# ==============================================================================
# Butch Master — Environment Configuration Reference (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development, or add these variables to your
# hosting platform dashboard (e.g., Vercel -> Project Settings -> Environment Variables).
# ==============================================================================

# System Variables (automatically populated in AI Studio runtime)
GEMINI_API_KEY=
APP_URL=

# ==============================================================================
# Firebase Web Client Configuration
# ==============================================================================
# Steps to find these values in Firebase Console:
# 1. Open your Firebase project: https://console.firebase.google.com/
# 2. Click the gear icon (⚙️) next to Project Overview -> "Project settings".
# 3. Under "General", scroll down to "Your apps" section.
# 4. Under your Web App (</>), look at the "firebaseConfig" code snippet.
# 5. Copy each corresponding value below.
#
# NOTE: If these variables are not provided, the application will safely continue
# running in offline localStorage mode without crashing.
# ==============================================================================

# Required: Firebase Web API Key (apiKey)
VITE_FIREBASE_API_KEY=

# Required: Firebase Auth Domain (authDomain, e.g. your-project.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=

# Required: Firebase Project ID (projectId, e.g. butch-master-app)
VITE_FIREBASE_PROJECT_ID=

# Required: Firebase Web App ID (appId, e.g. 1:1234567890:web:abcdef123456)
VITE_FIREBASE_APP_ID=

# Companion: Cloud Storage Bucket (storageBucket, e.g. your-project.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=

# Companion: Firebase Cloud Messaging Sender ID (messagingSenderId)
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firestore Database ID (set to your named database if using one, e.g. ai-studio-butchmastercosti-e60bd766-5bca-476e-b000-ecaa50c5ab6e, or (default))
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-butchmastercosti-e60bd766-5bca-476e-b000-ecaa50c5ab6e


