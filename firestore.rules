rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Butch Masters single-business data storage (no authentication required)
    match /users/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /business/{businessId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
