rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Isolated User Data Workspace: strict user isolation
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User's Subcollections (products, cost_items, orders, inventory, stock_logs, expenses, settings)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Top-Level Collections fallback
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
